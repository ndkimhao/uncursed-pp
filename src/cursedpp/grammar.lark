// Mini-grammars for the structured fragments of a .cursed file.
// The line-level pass in parser.py decides which start rule applies.

signature: CNAME "(" [param_list] ")"
param_list: param ("," param)*
param: CNAME [":" type]

type: "seq" "<" type ">"        -> seq_type
    | "tuple" "<" name_list ">" -> tuple_type
    | "token"                   -> token_type
name_list: CNAME ("," CNAME)*

for_line: "for" for_target "in" CNAME
for_target: "(" name_list ")" -> unpack_target
          | CNAME             -> var_target

expr: CNAME -> var_ref

%import common.CNAME
%import common.WS_INLINE
%ignore WS_INLINE
