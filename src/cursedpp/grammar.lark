// Mini-grammars for the structured fragments of a .cursed file.
// The line-level pass in parser.py decides which start rule applies.

signature: CNAME "(" [param_list] ")"
param_list: param ("," param)*
param: "named" "variadic" CNAME "=" [DEFAULT] -> named_variadic_param
     | "named" CNAME "=" [DEFAULT] -> named_param
     | CNAME "=" [DEFAULT]         -> defaulted_param
     | CNAME [":" type]            -> plain_param
DEFAULT: /[^,()\s][^,()]*/

type: "seq" "<" type ">"        -> seq_type
    | "tuple" "<" name_list ">" -> tuple_type
    | "token"                   -> token_type
    | "variadic" ["<" type ">"] -> variadic_type
name_list: CNAME ("," CNAME)*

for_line: "for" for_target "in" CNAME
for_target: "(" name_list ")" -> unpack_target
          | CNAME             -> var_target

join_header: "join" CNAME ["as" CNAME] "with" ESCAPED_STRING

let_line: "let" CNAME ":=" expr

cond: expr [CMP INT]
CMP: "==" | "!=" | "<=" | ">=" | "<" | ">"

expr: CNAME "(" expr ("," expr)* ")" -> func_call
    | postfix
postfix: CNAME accessor*
accessor: "." CNAME  -> field_access
        | "[" INT "]" -> index_access

%import common.CNAME
%import common.INT
%import common.ESCAPED_STRING
%import common.WS_INLINE
%ignore WS_INLINE
