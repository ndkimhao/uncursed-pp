// Mini-grammars for the structured fragments of a .uncursed file.
// The line-level pass in parser.py decides which start rule applies.
// Uncursed variables are $-prefixed (DNAME) at binding and use sites;
// bare CNAMEs in expressions are literal tokens.

signature: CNAME "(" [param_list] ")"
param_list: param ("," param)* ","?
param: "required" "named" "variadic" DNAME [":" type] -> required_named_variadic_param
     | "required" "named" DNAME               -> required_named_param
     | "named" "variadic" DNAME [":" type] "=" [DEFAULT] -> named_variadic_param
     | "named" "variadic" DNAME [":" type]    -> named_variadic_param
     | "named" DNAME "=" [DEFAULT] -> named_param
     | "named" DNAME               -> named_param
     | DNAME "=" [DEFAULT]         -> defaulted_param
     | DNAME [":" type]            -> plain_param
DEFAULT: /[^,()\s][^,()]*/

type: "seq" "<" type ">"                        -> seq_type
    | "seq_or_token" "<" type ">"               -> seq_or_token_type
    | "tuple" "<" type "..." ">"                -> var_tuple_type
    | "tuple" "<" name_list "," type "..." ">"  -> hybrid_tuple_type
    | "tuple" "<" field_list ">"                -> tuple_type
    | "tuple_or_token" "<" field_list ">"       -> tuple_or_token_type
    | "tuple"                                   -> bare_var_tuple_type
    | "token"                                   -> token_type
    | "variadic" ["<" type ">"]                 -> variadic_type
name_list: DNAME ("," DNAME)*
field_list: field ("," field)*
field: DNAME "=" [FDEFAULT] -> dfl_field
     | DNAME "?"            -> maybe_field
     | DNAME                -> req_field
// like DEFAULT, but stops before the type's closing '>'
FDEFAULT: /[^,()<>\s][^,()<>]*/

for_line: "for" for_target "in" DNAME
for_target: "(" name_list ")" -> unpack_target
          | DNAME             -> var_target

join_header: "join" DNAME ["as" DNAME] "with" ESCAPED_STRING

let_line: "let" DNAME ":=" expr

cond: expr [CMP INT]
CMP: "==" | "!=" | "<=" | ">=" | "<" | ">"

expr: CNAME "(" expr ("," expr)* ")" -> func_call
    | postfix
postfix: DNAME accessor*  -> var_postfix
       | CNAME accessor*  -> literal_postfix
accessor: "." DNAME  -> field_access
        | "[" INT "]" -> index_access

DNAME: /\$[A-Za-z_]\w*/

%import common.CNAME
%import common.INT
%import common.ESCAPED_STRING
%import common.WS_INLINE
%ignore WS_INLINE
