# Branch on argument count: single-arg vs n-arg initializer.
@macro CTOR(name, args: seq<tuple<type, argname>>)
@if len(args) == 1
  explicit_single_arg_init({{name}})
@else
  {{concat(name, _init)}}(@join args with ", ": {{argname}}@end)
@end
@endmacro

# ── invocation specs (verified through cc -E by test_e2e_specs) ──
#?  CTOR(w, ((int, x)))
#=>     explicit_single_arg_init(w)

#?  CTOR(w, ((int, x))((int, y)))
#=>     w_init(x, y)

#?  CTOR(w, ((int, x))((int, y))((int, z)))
#=>     w_init(x, y, z)
