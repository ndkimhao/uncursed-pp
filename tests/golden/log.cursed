# Tail defaults: arity dispatch at C compile time.
#   LOG(m) / LOG(m, WARN) / LOG(m, WARN, stdout)
macro LOG(msg, level = INFO, out = stderr)
fprintf({{out}}, "[" #{{level}} "] %s\n", {{msg}});
end

# ── invocation specs (verified through cc -E by test_integration) ──
#? LOG(m) => fprintf(stderr, "[" "INFO" "] %s\n", m);
#? LOG(m, WARN) => fprintf(stderr, "[" "WARN" "] %s\n", m);
#? LOG(m, WARN, stdout) => fprintf(stdout, "[" "WARN" "] %s\n", m);
