# Maybe-paren stripping: wrap a comma-containing value at the call site.
macro PAIR(p: tuple<a, b>)
S{ {{remove_parens(p.a)}} | {{p.b}} }
end

# ── invocation specs (verified through cc -E by test_integration) ──
#? PAIR((a, b)) => S{ a | b }
#? PAIR(((pair<int,int>), b)) => S{ pair<int,int> | b }
#? PAIR(((a, b), (c, d))) => S{ a, b | (c, d) }
