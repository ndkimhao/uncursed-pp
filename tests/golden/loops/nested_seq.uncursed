# seq<seq<token>>: index the outer seq, bind the inner one with @let,
# then loop over it (one loop level - the outer access is an index).
@macro FIRST_ROW($grid: seq<seq<token>>)
@let $row := $grid[0]
@for $x in $row
cell({{$x}});
@end
@endmacro

# ── invocation specs (verified through cc -E by the spec harness) ──
#?  FIRST_ROW(((a)(b))((c)(d)))
#=>     cell(a); cell(b);

# edge: single row, single cell
#?  FIRST_ROW(((z)))
#=>     cell(z);
