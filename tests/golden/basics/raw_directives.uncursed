# '@#' passes a raw preprocessing directive through to the generated
# header VERBATIM, at its source position; trailing backslashes
# continue the directive onto the next line.
@#include <iso646.h>
@#define CAP 16
@#define MK_PAIR(a, b) \
    { (a), (b) }

@macro CAPPED($n)
(({{$n}}) < CAP ? ({{$n}}) : CAP)
@endmacro

# ── invocation specs (verified through cc -E by test_e2e_specs) ──
# (iso646.h is macro-only, so the include adds no output tokens)
# the emitted '#define CAP 16' is real: the preprocessor expands it
#?  CAPPED(3)
#=>     ((3) < 16 ? (3) : 16)

# the continued directive is a callable C macro
#?  MK_PAIR(1, 2)
#=>     { (1), (2) }
