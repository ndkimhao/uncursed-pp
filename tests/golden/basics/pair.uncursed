# Maybe-paren stripping: wrap a comma-containing value at the call site.
@macro PAIR($p: tuple<$a, $b>)
S{ {{remove_parens($p.$a)}} | {{$p.$b}} }
@endmacro

# ── invocation specs (verified through cc -E by test_e2e_specs) ──
#?  PAIR((a, b))
#=>     S{ a | b }

#?  PAIR(((pair<int,int>), b))
#=>     S{ pair<int,int> | b }

# edge: both elements contain commas; only the wrapped one is unwrapped
#?  PAIR(((a, b), (c, d)))
#=>     S{ a, b | (c, d) }

# edge: empty first element
#?  PAIR((, b))
#=>     S{ | b }
