# Element access: seq indexing and chained seq[i].field access.
@macro HEADTAIL($xs: seq<token>)
{{$xs[0]}} ... {{$xs[1]}}
@endmacro

@macro SECOND_NAME($xs: seq<tuple<$t, $n>>)
{{$xs[1].$n}}
@endmacro

# ── invocation specs (verified through cc -E by the spec harness) ──
#?  HEADTAIL((a)(b))
#=>     a ... b

#?  SECOND_NAME(((int, x))((float, y)))
#=>     y

# is_empty($p) is a WHOLE-value use: it must consult the tuple itself,
# never a stray identifier left behind by the spread pass
@macro PROBE($p: tuple<$x, $y>)
{{$p.$x}}/{{$p.$y}} empty={{is_empty($p)}}
@endmacro

#?  PROBE((3, 4))
#=>     3/4 empty=0
