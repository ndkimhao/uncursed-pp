# Element access: seq indexing and chained seq[i].field access.
macro HEADTAIL(xs: seq<token>)
{{xs[0]}} ... {{xs[1]}}
end

macro SECOND_NAME(xs: seq<tuple<t, n>>)
{{xs[1].n}}
end

# ── invocation specs (verified through cc -E by the spec harness) ──
#?  HEADTAIL((a)(b))
#=>     a ... b

#?  SECOND_NAME(((int, x))((float, y)))
#=>     y
