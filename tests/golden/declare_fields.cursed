# Declare one struct field per (type, name) tuple.
macro DECLARE_FIELDS(fields: seq<tuple<type, name>>)
@for (type, name) in fields
  {{type}} {{name}};
@end
end

# ── invocation specs (verified through cc -E by test_integration) ──
#? DECLARE_FIELDS(((int, x))) => int x;
#? DECLARE_FIELDS(((int, x))((float, y))((char *, name))) => int x; float y; char * name;
#? DECLARE_FIELDS(((struct foo *, p))) => struct foo * p;
