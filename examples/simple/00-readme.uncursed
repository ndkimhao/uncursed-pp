# The front-page example from README.md, as a real, spec-checked source
# file — if the README ever drifts from what the compiler does, this file's
# specs fail the suite.
#
# `variadic<tuple<type, name>>` gives single-paren call sites; loop chains
# are off so the generated header stays three defines (drop the pragma for
# the ~25x-cheaper chain codegen; see docs/optimization.md).

# demo only: skip the (faster, but longer) loop-chain codegen
@pragma loop_chain off

@macro DECLARE_FIELDS($fields: variadic<tuple<$type, $name>>)
@for ($type, $name) in $fields
  {{$type}} {{$name}};
@end
@endmacro

# ── invocation specs (verified through cc -E by the spec harness) ──
#?  DECLARE_FIELDS((int, x), (float, y))
#=>     int x; float y;

#?  DECLARE_FIELDS((char *, name))
#=>     char * name;
