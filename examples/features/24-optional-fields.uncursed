# ── Optional trailing tuple fields ───────────────────────────────────
#
# After a tuple's required fields, trailing fields can be optional in
# two ways:
#
#   $field = value   omitted at the call site -> the default fills in
#   $field?          omitted at the call site -> truly ABSENT
#
# For a `?` field, `has($t.$field)` is 1/0 at C compile time, and
# accessing an absent field expands to zero tokens. The call site
# passes any prefix: (a), (a, b), (a, b, c) - the width is dispatched
# when the C compiler expands the macro, like everything else here.
#
# Scenario: a register description where the reset value is optional
# and the access qualifier defaults.

@macro REG($r: tuple<$name, $addr, $qual = volatile, $reset?>)
enum { {{concat($r.$name, _ADDR)}} = {{$r.$addr}} };
@if has($r.$reset)
static {{$r.$qual}} int {{concat($r.$name, _reset)}} = {{$r.$reset}};
@end
@endmacro

# All four fields:
#?  REG((CTRL, 0x40, volatile, 0x1))
#=>     enum { CTRL_ADDR = 0x40 }; static volatile int CTRL_reset = 0x1;

# Reset omitted - the @if branch vanishes entirely:
#?  REG((STAT, 0x44))
#=>     enum { STAT_ADDR = 0x44 };

# It composes: optional-field tuples as seq elements, loop-unpacked.
@macro FIELDS($fs: seq<tuple<$name, $type = int>>)
@for ($name, $type) in $fs
{{$type}} {{$name}};
@end
@endmacro

#?  FIELDS(((n))((f, float)))
#=>     int n; float f;

# ── tuple_or_token: mixed bare/tuple elements ────────────────────────
#
# `tuple_or_token<...>` additionally lets a call site pass a BARE token
# where a tuple is expected - it supplies the single required field,
# and every optional field behaves as if omitted. Opt-in because each
# element pays a small paren probe (fused into the width dispatch).
#
# Typed `named variadic` keywords compose with it: annotate the element
# type and the keyword's value becomes an iterable list.

@macro DEFINE_STRUCT($name,
    named variadic $MEMBERS: tuple_or_token<$m, $init?> = ,
    named variadic $FUNCS: token = )
struct {{$name}} { @join $MEMBERS as $f with " ": @if has($f.$init) @then {{$f.$m}} = {{$f.$init}}, @else {{$f.$m}}, @end@end @join $FUNCS as $g with " ": {{$g}}(), @end };
@endmacro

#?  DEFINE_STRUCT(Foo, MEMBERS(a, b, (c, 1), d), FUNCS(q, w))
#=>     struct Foo { a, b, c = 1, d, q(), w(), };

# Keywords stay optional and order-free; empty default = zero elements:
#?  DEFINE_STRUCT(Bar, FUNCS(tick))
#=>     struct Bar { tick(), };

# And the seq flavor: seq_or_token<T> promotes a bare value to a
# single-element seq - handy when "one thing" shouldn't need wrapping.
@macro ON_EVENTS($handler, named variadic $EVENTS: seq_or_token<token> = )
@for $g in $EVENTS
{ @join $g as $e with ",": {{$e}}@end } -> {{$handler}};
@end
@endmacro

#?  ON_EVENTS(h, EVENTS(open, (close)(abort)))
#=>     { open } -> h; { close,abort } -> h;
